# Copy to .env for local development.
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1
# CSRF_TRUSTED_ORIGINS=https://fuatilia.example.com

# Defaults to SQLite in the project folder. In production use Postgres:
# DATABASE_URL=postgres://user:password@host:5432/fuatilia

# Where uploaded evidence is stored (must be private, persistent storage).
# MEDIA_ROOT=/var/lib/fuatilia/media

# Email for password resets and reminders (console output when DEBUG is on).
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=Fuatilia <help@fuatilia.example.com>
